{
  "name": "peon-pet",
  "productName": "Peon Pet",
  "version": "1.0.0-alpha.1",
  "description": "Desktop pet for Peon-Ping — an orc that reacts to peon-ping events",
  "main": "main.js",
  "bin": {
    "peon-pet": "./bin/peon-pet.js"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/dev.js",
    "build": "electron-builder --mac dir",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "build": {
    "appId": "com.peonpet.app",
    "productName": "Peon Pet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "lib/*.js",
      "patches/**"
    ],
    "asarUnpack": [
      "renderer/assets/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "commander": "^15.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.2"
  },
  "overrides": {
    "boolean": "file:./patches/boolean-shim"
  }
}
